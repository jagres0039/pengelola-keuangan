# Telegram bot token dari @BotFather
TELEGRAM_BOT_TOKEN=replace_me

# Database connection string
# Production (PostgreSQL via docker-compose):
DATABASE_URL=postgresql+psycopg://bot:bot@localhost:5432/pengelola_keuangan
# Untuk local dev / testing tanpa Postgres, bisa pake SQLite:
# DATABASE_URL=sqlite:///./data/pengelola_keuangan.db

# Default timezone untuk user baru (IANA tz name)
DEFAULT_TIMEZONE=Asia/Jakarta

# Default currency code untuk user baru (3-letter)
DEFAULT_CURRENCY=IDR

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: comma-separated telegram_user_id yang boleh akses bot.
# Kosongin = bebas (siapa aja bisa /start dan pake bot).
# Contoh: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=
