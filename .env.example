# ---------- Bot Telegram ----------
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=replace_me

# Optional: comma-separated telegram_user_id yang boleh akses bot.
# Kosongin = bebas (siapa aja bisa /start dan pake bot).
ALLOWED_USER_IDS=

# ---------- Database ----------
# Production (PostgreSQL via docker-compose):
DATABASE_URL=postgresql+psycopg://bot:bot@db:5432/pengelola_keuangan
# Untuk local dev tanpa Postgres, bisa pake SQLite:
# DATABASE_URL=sqlite:///./data/pengelola_keuangan.db
POSTGRES_USER=bot
POSTGRES_PASSWORD=changeme_random_string
POSTGRES_DB=pengelola_keuangan

# ---------- Lokal & format ----------
DEFAULT_TIMEZONE=Asia/Jakarta
DEFAULT_CURRENCY=IDR
LOG_LEVEL=INFO

# ---------- Gemini Vision (OCR struk) ----------
# Dapetin gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ---------- FastAPI / PWA ----------
# Wajib di-set di production. Minimal 32 karakter random.
# Generate: openssl rand -hex 32
JWT_SECRET=please_change_me_to_a_long_random_string_at_least_32_chars
# Durasi access token (menit). Default = 30 hari.
JWT_EXPIRES_MINUTES=43200
# CORS: kalau PWA & API beda domain, isi domain PWA lo (comma-separated).
# Default '*' aman buat development; di prod biasanya same-origin via nginx.
CORS_ALLOW_ORIGINS=*

# Instruksi pembayaran manual yang ditampilkan di halaman /billing PWA.
# Pakai \n untuk newline (dibaca via python-dotenv).
# Contoh:
# BILLING_INSTRUCTIONS="Transfer ke salah satu rekening berikut:\n\nBCA 1234567890 a.n. Budi\nDANA 081234567890 a.n. Budi"
BILLING_INSTRUCTIONS=

# ---------- Nginx / Let's Encrypt ----------
# Domain publik (dipake nginx + Let's Encrypt)
DOMAIN=finance-0039.duckdns.org
LETSENCRYPT_EMAIL=you@example.com
# Set "bootstrap" saat first-run (HTTP only, untuk dapet cert pertama),
# lalu ganti ke "app" (default) setelah cert terbit.
# NGINX_TEMPLATE=app

# ---------- DuckDNS auto-update ----------
# Kalau lo pakai DuckDNS, isi ini supaya IP subdomain auto-sync ke VPS.
DUCKDNS_SUBDOMAIN=finance-0039
DUCKDNS_TOKEN=
